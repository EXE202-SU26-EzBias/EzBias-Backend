# Runtime
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# PostgreSQL
POSTGRES_DB=ezbias_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# JWT
JWT_ISSUER=EzBias
JWT_AUDIENCE=EzBias.Client
JWT_SECRET=LOCAL_DEV_ONLY_CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_PLUS
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# SMTP (leave blank in local demo: OTP codes will be logged by the API)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EzBias

# Marketplace commission
COMMISSION_RATE_PERCENT=8

# Cloudinary product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ezbias/products
