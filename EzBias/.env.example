# Runtime
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# PostgreSQL
POSTGRES_DB=ezbias_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# JWT
JWT_ISSUER=EzBias
JWT_AUDIENCE=EzBias.Client
JWT_SECRET=LOCAL_DEV_ONLY_CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_PLUS
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# Seed data (local development defaults only; use strong Admin credentials in production)
SEED_DATA_ENABLED=true
ADMIN_FULL_NAME=Demo Admin
ADMIN_USERNAME=demo_admin
ADMIN_EMAIL=admin.demo@ezbias.local
ADMIN_PASSWORD=Admin@123
DEBUG_RESET_SECRET=

# Brevo transactional email (OTP codes will be logged if not configured)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=EzBias

# Marketplace commission
COMMISSION_RATE_PERCENT=8

# Cloudinary product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ezbias/products
CLOUDINARY_REVIEW_FOLDER=ezbias/reviews
